  spawnPrefab: {fileID: 919132149155446097, guid: 98887967cb2d5c74ea89772ce880a789, type: 3}
  spawnPoint: {fileID: 1347975577}
  gnomePrefab: {fileID: 663823197}
  spawnPrefabPoint: {fileID: 304055793}
  gnomeAppearTextUI: {fileID: 249581905}
  firmaDialogue:
  - text: NOOOOO!!! QUE HAS HECHO!!
    delay: 4
  - text: "VOLVER\xC9, {PlayerPCName}!"
    delay: 4
  - text: NO QUIERO VOLVER AL CIBERESPACIO
    delay: 4
  - text: aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
    delay: 4
  gnomePhrase1: Este es tu fin, Hongo!
  gnomePhrase2: Y luego te toca a ti {PlayerPCName}
  gnomePhrase3: Esta... es... <b>MI CASA!</b>
  gnomeDelay1: 4
  gnomeDelay2: 4
  gnomeDelay3: 3
  stage2Text_collectible2: "Y as\xED? Menuda fuerza tengo, t\xFA"
  stage2Text_collectible3: Mira lo que hago entonces! <b>Boing boing!!</b>
  lastCollectibleText: Gracias ala valentia de Hongo esta noche vuelve a casa con
    el saco lleno!! Hongo y Honga vivieron felizes para siempre y comieron bellotas!!!!!
  lastCollectibleGnome2Lines:
  - text: Pues ahora que te lo has terminado
    delay: 4
  - text: Si no es molestia, me lo llevo...
    delay: 4
  - text: "...y as\xED lo juegan otros!"
    delay: 4
  - text: Muchas gracias por jugar mi juego!!
    delay: 4
  introTextUI: {fileID: 0}
  introText: 
  debugMode: 0
  debugStartIndex: 6
